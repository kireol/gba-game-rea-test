{
  "name": "orbit-drop",
  "private": true,
  "version": "0.1.0",
  "description": "Orbit Drop - an original browser falling-block puzzle game",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "npm run test && npm run test:e2e",
    "report": "node scripts/forbidden-name-sweep.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
